# Copy this file to .env and fill in the values. .env is git-ignored.
# Never paste a key into a chat, a commit or a document.

# Claude API key, from platform.claude.com. Needed by every agent.
ANTHROPIC_API_KEY=

# Optional. Financial Modeling Prep, for earnings dates, estimates and news.
FMP_API_KEY=

# Optional. Tradier: the second source of live option quotes, used when Cboe does not answer.
# Also used by chain_census.py with --source tradier.
TRADIER_TOKEN=

# SEC EDGAR asks automated clients to identify themselves: a name and a contact email.
# Example format: Tradecraft personal research you@example.com (never commit the real value)
SEC_USER_AGENT=

# FRED (Federal Reserve Bank of St. Louis): free key, for the dates of data releases such as CPI.
FRED_API_KEY=
